# Generated by ../scripts/write-dashboard-env.sh from Terraform outputs. Never commit .env.

# Temporal Cloud namespace id (<namespace>.<account>)
TEMPORAL_NAMESPACE=
# Namespace Endpoint used by the load generator (<namespace>.<account>.tmprl.cloud:7233)
TEMPORAL_ADDRESS=
# Load-generator service account key (Write)
TEMPORAL_LOAD_API_KEY=
# Failover service account key (namespace admin / failover custom role)
TEMPORAL_FAILOVER_API_KEY=
# GCP project whose Managed Prometheus holds the worker metrics (queried with your gcloud ADC)
GCP_PROJECT_ID=

# Optional
# TASK_QUEUE=money-transfer
# TRANSFER_PAUSE_SECONDS=20
# PORT=3000
# CLOUD_OPS_URL=https://saas-api.tmprl.cloud
# CLOUD_OPS_API_VERSION=   # pin a Cloud Ops API version; omitted = latest
# METRICS_QUERY_URL=   # override the Prometheus API base (default: GMP for GCP_PROJECT_ID)
# TEMPORAL_INSECURE=true   # local dev server only: no TLS, no load key
